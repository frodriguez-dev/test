# Copy this file to backend/.env and adjust the values for your environment.
# Never commit a real .env file or real credentials.

# Django
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send unsafe requests (the frontend dev server).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (names match the official postgres image for Docker Compose)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
